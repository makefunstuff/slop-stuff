[
{{- $pages := .Site.RegularPages -}}
{{- range $i, $p := $pages -}}
{{- if $i }},{{ end -}}
{
  "title": {{ $p.Title | jsonify }},
  "url": {{ $p.Permalink | jsonify }},
  "category": {{ $p.Params.category | default "" | jsonify }},
  "description": {{ $p.Params.description | default "" | jsonify }},
  "tags": {{ $p.Params.tags | default slice | jsonify }}
}
{{- end -}}
]
